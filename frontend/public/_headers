# Cloudflare Pages headers.
# LEDGER runs only as an embedded panel inside Procore — allow Procore to
# frame it and nobody else. (Cloudflare Pages sets no X-Frame-Options by
# default, so frame-ancestors is the whole control here.)
/*
  Content-Security-Policy: frame-ancestors https://*.procore.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
